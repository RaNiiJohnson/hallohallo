# =============================================================================
# Hallomada environment template
#
# Copy only the CLIENT / NEXT.JS block to `.env.local`.
# Configure the CONVEX BACKEND block on each Convex deployment with:
#
#   pnpm exec convex env set KEY value
#
# Check the configured backend variables with:
#
#   pnpm exec convex env list
#
# Never commit real secrets. Development and production deployments must each
# receive their own backend values.
# =============================================================================

# ----- CLIENT / NEXT.JS (`.env.local`) ---------------------------------------

# Written automatically by `pnpm exec convex dev`. Keep the generated value.
CONVEX_DEPLOYMENT=dev:<deployment-name>

# Public Convex endpoints.
NEXT_PUBLIC_CONVEX_URL=https://<deployment>.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://<deployment>.convex.site

# Browser analytics. Both values are required by the current development guard.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_<project-token>
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Optional: link displayed in the administration dashboard.
NEXT_PUBLIC_POSTHOG_DASHBOARD_URL=

# ----- CONVEX BACKEND (`convex env set`) -------------------------------------

# Authentication
# Generate a high-entropy value of at least 32 characters.
BETTER_AUTH_SECRET=
SITE_URL=http://localhost:3000

# Optional comma-separated origins when the application has additional trusted
# frontends. SITE_URL is already used as the main authentication URL.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI translations
# The code currently expects this exact variable name (`OPEN_API_KEY`).
OPEN_API_KEY=

# Transactional email (Resend)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Cloudflare R2 storage
R2_BUCKET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# PostHog server-side component
# POSTHOG_PROJECT_TOKEN is required by `convex/convex.config.ts`.
POSTHOG_PROJECT_TOKEN=phc_<project-token>

# Optional PostHog backend configuration.
POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_PERSONAL_API_KEY=
POSTHOG_FLAGS_POLLING_INTERVAL_SECONDS=60

# ----- OPTIONAL FEATURE INTEGRATIONS -----------------------------------------

# Stripe — required only when payment or subscription flows are enabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudinary — retained for legacy media compatibility. New uploads use R2.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ----- PROVIDED AUTOMATICALLY BY CONVEX --------------------------------------
# Do not set these manually:
# CONVEX_CLOUD_URL
# CONVEX_SITE_URL
